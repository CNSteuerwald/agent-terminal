{
  "name": "agent-terminal",
  "version": "0.1.11",
  "description": "A terminal for running agent CLIs (Claude Code, Copilot, Codex, Gemini, OpenCode) side by side with a shell, one folder per tab.",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder --win --publish never",
    "release": "electron-builder --win --publish always"
  },
  "license": "MIT",
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "electron-updater": "^6.8.11",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "allowScripts": {
    "electron@45.2.3": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/CNSteuerwald/agent-terminal.git"
  },
  "build": {
    "appId": "com.cnsteuerwald.agentterminal",
    "productName": "Agent Terminal",
    "artifactName": "Agent-Terminal-Setup-${version}.${ext}",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**",
      "src/shim/**"
    ],
    "npmRebuild": false,
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "CNSteuerwald",
        "repo": "agent-terminal",
        "private": true,
        "releaseType": "draft"
      }
    ]
  }
}
